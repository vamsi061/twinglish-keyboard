<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed only for optional online translation (Google Translate). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TwinglishApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Twinglish"
        tools:targetApi="26">

        <!-- The keyboard itself. -->
        <service
            android:name=".ime.TwinglishInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ime" />
        </service>

        <!-- Launcher: settings + test entry points. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".test.KeyboardTestActivity"
            android:exported="false"
            android:label="@string/test_title" />

        <!-- Shows the crash stack trace on screen instead of a silent stop. -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Twinglish" />
    </application>
</manifest>
